<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="gwv_pos_receipt.OrderChangeReceipt" t-inherit="point_of_sale.OrderChangeReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt')]" position="replace">
            <div class="pos-receipt gwv-kitchen-receipt m-0 p-2" style="font-size: 16px; font-family: monospace, sans-serif; color: #000;">
                <!-- Header based on user specification -->
                <div class="receipt-header text-start mb-2" style="font-size: 15px; line-height: 1.5;">
                    <!-- <div t-if="changes.takeaway" class="text-center fw-bold mb-1" style="font-size: 18px;">
                        *** NEW ***
                    </div> -->
                    <div><strong>Order Time:</strong> <t t-esc="changes.order_time || changes.time"/></div>
                    <div><strong>Cashier:</strong> <t t-esc="changes.cashier_name || changes.employee_name"/></div>
                    <div><strong>Invoice:</strong> <t t-esc="changes.order_name || changes.tracking_number || '-'"/></div>
                    <!-- <div t-if="changes.table_name"><strong>Table:</strong> <t t-esc="changes.table_name"/></div> -->
                </div>

                <!-- Dashed Separator -->
                <div class="gwv-dashed-line my-2" style="border: none; border-top: 2px dashed black;"/>

                <!-- Receipt Body / Order Lines -->
                <div class="pos-receipt-body pb-3">
                    <t t-if="operational_title">
                        <div class="pos-receipt-title text-center fw-bold mb-2 text-danger" style="font-size: 18px;" t-esc="operational_title" />
                    </t>

                    <div class="orderlines">
                        <div t-foreach="changedlines" t-as="line" t-key="change_index" class="my-2" style="font-size: 17px; line-height: 1.3;">
                            <div t-attf-class="orderline #{line.isCombo ? 'ms-3' : ''}">
                                <div class="d-flex align-items-start">
                                    <span class="fw-bold me-2" style="min-width: 28px;"><t t-esc="line.quantity"/>x</span>
                                    <span class="product-name fw-bold flex-grow-1"><t t-esc="line.display_name"/></span>
                                </div>
                                <div t-if="line.attribute_value_ids?.length" class="ms-4 small" style="font-size: 14px;">
                                    <t t-foreach="line.attribute_value_ids" t-as="attribute" t-key="attribute.id">
                                        <p class="p-0 m-0">- <t t-esc="attribute.name" /></p>
                                    </t>
                                </div>
                                <div t-if="line.note" class="ms-4 fst-italic fw-bold small text-danger" style="font-size: 14px;">
                                    Note: <t t-esc="line.note.split('\n').join(', ')"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- General Order Note -->
                    <t t-if="(!changedlines.length or fullReceipt) and changes.order_note">
                        <div class="mt-3 fst-italic pt-2" style="border-top: 1px dashed black; font-size: 15px;">
                            <strong>Order Note:</strong> <t t-esc="changes.order_note.split('\n').join(', ')"/>
                        </div>
                    </t>
                </div>
            </div>
        </xpath>
    </t>

</templates>
