<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="gwv_pos_receipt.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt')]" position="replace">
            <div class="pos-receipt gwv-receipt p-2" t-attf-style="font-size: {{props.data?.customReceipt?.fontSize || 16}}px;">
                <t t-set="custom" t-value="props.data.customReceipt or {}"/>

                <!-- Header / Logo -->
                <div class="text-center gwv-header-block">
                    <img t-if="custom.logoUrl" t-att-src="custom.logoUrl" alt="Logo" class="gwv-receipt-logo mb-2"/>
                    <div t-if="custom.companyName" class="gwv-company-name fw-bold" t-esc="custom.companyName"/>
                    <div t-if="custom.vatTin" class="gwv-header-line">VAT TIN: <t t-esc="custom.vatTin"/></div>
                    <div t-if="custom.address" class="gwv-header-line" t-esc="custom.address"/>
                    <div t-if="custom.phone" class="gwv-header-line">Tel: <t t-esc="custom.phone"/></div>
                </div>

                <!-- Dashed Separator -->
                <div class="gwv-dashed-line"/>

                <!-- Order Metadata -->
                <div class="gwv-receipt-meta">
                    <div class="d-flex justify-content-between">
                        <span class="text-nowrap">Date: <t t-esc="custom.date"/></span>
                        <span class="text-nowrap text-end ms-2">Inv No. <t t-esc="custom.invNo"/></span>
                    </div>
                    <div>Cashier: <t t-esc="custom.cashierName"/></div>
                    <div>Customer: <t t-esc="custom.customerName"/></div>
                    <div>Bill Printed: <t t-esc="custom.billPrintedDate"/></div>
                </div>

                <!-- Single Unified Orderlines Table (Center-Aligned Grid) -->
                <table class="gwv-table w-100 my-2">
                    <thead>
                        <tr class="gwv-thead-row">
                            <th class="text-start" style="width: 46%;">Item Name</th>
                            <th class="text-center" style="width: 14%;">Qty</th>
                            <th class="text-end" style="width: 20%;">U.Price</th>
                            <th class="text-end" style="width: 20%;">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="custom.orderlines or []" t-as="line" t-key="line_index">
                            <tr class="gwv-orderline-row">
                                <td class="text-start align-top">
                                    <div class="gwv-product-name text-break" t-esc="line.productName"/>
                                    <div t-if="line.discount and line.discount !== '0'" class="gwv-line-sub">
                                        Disc: <t t-esc="line.discount"/>%
                                    </div>
                                    <div t-if="line.customerNote" class="gwv-line-sub fst-italic">
                                        Note: <t t-esc="line.customerNote"/>
                                    </div>
                                    <t t-foreach="line.packLotLines or []" t-as="lot" t-key="lot_index">
                                        <div class="gwv-line-sub" t-esc="lot"/>
                                    </t>
                                </td>
                                <td class="text-center align-top"><t t-esc="line.formattedQty"/></td>
                                <td class="text-end align-top"><t t-esc="line.formattedUnitPrice"/></td>
                                <td class="text-end align-top"><t t-esc="line.formattedPrice"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- Dashed Separator before Totals -->
                <div class="gwv-dashed-line"/>

                <!-- Totals Section (Half page to the right) -->
                <div class="gwv-totals-wrapper">
                    <div class="gwv-totals-section">
                        <div class="gwv-row">
                            <span class="gwv-label">Sub-Total</span>
                            <span class="gwv-val" t-esc="custom.subtotal"/>
                        </div>
                        <div class="gwv-row">
                            <span class="gwv-label">Discount</span>
                            <span class="gwv-val" t-esc="custom.discount"/>
                        </div>
                        <!-- <t t-if="custom.taxList and custom.taxList.length">
                            <t t-foreach="custom.taxList" t-as="tax" t-key="tax_index">
                                <div class="gwv-row">
                                    <span class="gwv-label" t-esc="tax.name"/>
                                    <span class="gwv-val" t-esc="tax.amount"/>
                                </div>
                            </t>
                        </t> -->
                        <div class="gwv-row">
                            <span class="gwv-label">Grand Total KHR</span>
                            <span class="gwv-val" t-esc="custom.grandTotalKHR"/>
                        </div>
                        <div class="gwv-row">
                            <span class="gwv-label">Grand Total USD</span>
                            <span class="gwv-val" t-esc="custom.grandTotalUSD"/>
                        </div>

                        <!-- Dashed Separator above Total Sales (Half page) -->
                        <div class="gwv-dashed-line my-1"/>

                        <!-- Total Sales Row (Half page to the right) -->
                        <div class="gwv-total-sales-row d-flex justify-content-between align-items-center">
                            <span class="gwv-total-sales-label">Total Sales</span>
                            <span class="gwv-total-sales-val" t-esc="custom.totalSalesFormatted"/>
                        </div>

                        <!-- Double Separator Line below Total Sales (Half page) -->
                        <div class="gwv-double-line my-1"/>
                    </div>
                </div>

                <!-- Payments and Change (Half page to the right) -->
                <div class="gwv-totals-wrapper">
                    <div class="gwv-payments-section">
                        <div t-foreach="props.data.paymentlines or []" t-as="line" t-key="line_index" class="gwv-row">
                            <span class="gwv-label" t-esc="line.name"/>
                            <span class="gwv-val" t-esc="props.formatCurrency(line.amount)"/>
                        </div>

                        <t t-if="props.data.show_change and custom.changeUSD !== '0.00'">
                            <div class="gwv-row">
                                <span class="gwv-label">Change</span>
                                <span class="gwv-val">KHR <t t-esc="custom.changeKHR"/></span>
                            </div>
                            <div class="gwv-row">
                                <span class="gwv-label"></span>
                                <span class="gwv-val"><t t-esc="props.formatCurrency(props.data.order_change)"/></span>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Signature -->
                <div t-if="custom.showSignature" class="gwv-signature-section mt-4">
                    <div>Signature ................................................................</div>
                </div>

                <!-- Footer Notes & Exchange Rate -->
                <div class="gwv-footer text-center mt-3">
                    <div class="gwv-exchange-rate">Exchange Rate: KHR <t t-esc="custom.khrRate"/></div>
                    <div t-if="custom.footerNote" class="gwv-footer-note mt-1" t-esc="custom.footerNote"/>
                </div>

                <!-- Invoicing QR Code if applicable -->
                <t t-if="props.data.pos_qr_code">
                    <div class="text-center mt-3">
                        <img id="posqrcode" t-att-src="props.data.pos_qr_code" class="gwv-receipt-qrcode"/>
                        <div class="unique-code mt-1" style="font-size: 0.75rem;">Unique Code: <t t-esc="props.data.ticket_code"/></div>
                    </div>
                </t>

                <!-- Terminal Receipts -->
                <div class="after-footer">
                    <t t-foreach="props.data.paymentlines or []" t-as="line" t-key="line_index">
                        <t t-if="line.ticket">
                            <br />
                            <div class="pos-payment-terminal-receipt">
                                <pre t-esc="line.ticket" />
                            </div>
                        </t>
                    </t>
                </div>
            </div>
        </xpath>
    </t>
</templates>
