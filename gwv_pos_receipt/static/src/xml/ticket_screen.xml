<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="gwv_pos_receipt.TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <!-- Desktop order list: replace pos_reference with pos.order sequence -->
        <xpath expr="//t[@t-esc='order.pos_reference']" position="replace">
            <t t-esc="order.getOrderSequenceName ? order.getOrderSequenceName() : (order.name || order.pos_reference)"/>
        </xpath>
        <!-- Mobile order list: replace second pos_reference with pos.order sequence -->
        <xpath expr="//t[@t-esc='order.pos_reference']" position="replace">
            <t t-esc="order.getOrderSequenceName ? order.getOrderSequenceName() : (order.name || order.pos_reference)"/>
        </xpath>
    </t>

</templates>

