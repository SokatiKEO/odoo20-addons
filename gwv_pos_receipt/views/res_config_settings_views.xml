<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_gwv_receipt" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.gwv.receipt</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='point_of_sale']//div[@invisible='not pos_config_id']" position="inside">
                <block title="Order &amp; Printing Options" id="gwv_pos_order_defaults_section">
                    <setting string="Default POS Customer" help="Default customer automatically selected for new orders in this Point of Sale.">
                        <div class="content-group mt8">
                            <field name="pos_default_partner_id" placeholder="Select default customer..."/>
                        </div>
                    </setting>
                    <setting string="Default to Invoice" help="If ticked, new POS orders will have the Invoice option enabled by default.">
                        <field name="pos_default_to_invoice"/>
                    </setting>
                    <setting string="Print Bill with Kitchen Order" help="Automatically print the customer bill when clicking the Order button to send items to the kitchen.">
                        <field name="pos_print_bill_on_order"/>
                    </setting>
                    <setting string="Enable 2x Receipt Printing" help="Print the customer receipt twice (2x) for each order on hardware / ePOS printers.">
                        <field name="pos_enable_2x_printing"/>
                    </setting>
                </block>

                <block title="Custom Order Receipt" id="gwv_custom_receipt_section">
                    <setting string="Company &amp; Header Information" help="Company branding and contact details displayed at the top of the receipt.">
                        <div class="content-group mt8">
                            <div class="row mb-2">
                                <label for="pos_receipt_header_company_name" string="Company Name" class="col-lg-4 o_light_label"/>
                                <field name="pos_receipt_header_company_name" class="col-lg-8"/>
                            </div>
                            <div class="row mb-2">
                                <label for="pos_receipt_vat_tin" string="VAT TIN" class="col-lg-4 o_light_label"/>
                                <field name="pos_receipt_vat_tin" class="col-lg-8"/>
                            </div>
                            <div class="row mb-2">
                                <label for="pos_receipt_phone" string="Phone" class="col-lg-4 o_light_label"/>
                                <field name="pos_receipt_phone" class="col-lg-8"/>
                            </div>
                            <div class="row mb-2">
                                <label for="pos_receipt_address" string="Address" class="col-lg-4 o_light_label"/>
                                <field name="pos_receipt_address" class="col-lg-8"/>
                            </div>
                            <div class="row mt-2">
                                <label for="pos_receipt_custom_logo" string="Custom Logo" class="col-lg-4 o_light_label"/>
                                <field name="pos_receipt_custom_logo" widget="image" class="col-lg-8 oe_avatar"/>
                            </div>
                        </div>
                    </setting>

                    <setting string="Format, Currency &amp; Footer" help="Configure exchange rate, typography, signature line, and closing message.">
                        <div class="content-group mt8">
                            <div class="row mb-2">
                                <label for="pos_khr_exchange_rate" string="KHR Exchange Rate" class="col-lg-4 o_light_label"/>
                                <field name="pos_khr_exchange_rate" class="col-lg-8"/>
                            </div>
                            <div class="row mb-2">
                                <label for="pos_receipt_font_size" string="Font Size (px)" class="col-lg-4 o_light_label"/>
                                <field name="pos_receipt_font_size" class="col-lg-8"/>
                            </div>
                            <div class="row mb-2">
                                <label for="pos_receipt_show_signature" string="Show Signature" class="col-lg-4 o_light_label"/>
                                <field name="pos_receipt_show_signature" class="col-lg-8"/>
                            </div>
                            <div class="row">
                                <label for="pos_receipt_footer_note" string="Footer Note" class="col-lg-4 o_light_label"/>
                                <field name="pos_receipt_footer_note" class="col-lg-8"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
