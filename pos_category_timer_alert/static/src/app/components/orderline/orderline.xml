<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="pos_enterprise.Orderline" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_pdis_preview_btn')]" position="before">
            <div
                t-if="this.hasTimer"
                class="o_pdis_line_timer_wrap ms-auto flex-shrink-0 d-inline-flex align-items-center"
                t-att-class="{ 'o_pdis_line_alert_pulse': this.state.isAlert }"
                t-att-title="this.state.isAlert ? 'Category alert timer exceeded' : 'Preparation timer'"
            >
                <t t-foreach="this.state.timerParts" t-as="part" t-key="part.unit">
                    <span
                        class="o_pdis_timer_unit"
                        t-att-class="{
                            'o_pdis_timer_unit--alert': this.state.isAlert,
                            'o_pdis_timer_unit--normal': !this.state.isAlert
                        }"
                    >
                        <span class="o_pdis_timer_val" t-out="part.val"/>
                        <span class="o_pdis_timer_lbl" t-out="part.unit"/>
                    </span>
                </t>
            </div>
        </xpath>
        <xpath expr="//section[hasclass('o_preparation_display_orderline')]" position="attributes">
            <attribute name="t-attf-class" add="{{ this.state.isAlert ? 'o_pdis_orderline--alert' : '' }}" separator=" "/>
        </xpath>
    </t>
</templates>
