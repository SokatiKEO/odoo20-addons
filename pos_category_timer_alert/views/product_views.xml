<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_khmer_name" model="ir.ui.view">
        <field name="name">product.template.form.inherit.khmer.name</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="inside">
                <div class="mt-1">
                    <label for="khmer_name" string="Khmer Name" class="fw-semibold"/>
                    <field name="khmer_name" placeholder="ឈ្មោះផលិតផលជាភាសាខ្មែរ (Khmer Name)"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
