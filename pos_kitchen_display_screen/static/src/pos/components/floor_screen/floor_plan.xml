<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_kitchen_display_screen.floor_screen_element" t-inherit="pos_restaurant.floor_screen_element" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_fp_table_number')]" position="before">
            <t t-set="foodStage" t-value="this.getTableFoodStages(table)"/>
            <div t-if="foodStage.hasFood"
                 class="table-food-stages d-flex gap-1 z-2"
                 t-att-style="tableContentStyle">
                <!-- 1. Pending Order: Blue chip -->
                <span t-if="foodStage.pending > 0"
                      class="table-stage-chip table-stage-pending"
                      t-attf-title="Pending Order: {{ foodStage.pending }} item(s)">
                    <t t-out="foodStage.pending"/>
                </span>
                <!-- 2. Ready Order: Amber chip -->
                <span t-if="foodStage.ready > 0"
                      class="table-stage-chip table-stage-ready"
                      t-attf-title="Ready Order: {{ foodStage.ready }} item(s)">
                    <t t-out="foodStage.ready"/>
                </span>
                <!-- 3. Served Order: Green chip -->
                <span t-if="foodStage.served > 0"
                      class="table-stage-chip table-stage-served"
                      t-attf-title="Served Order: {{ foodStage.served }} item(s)">
                    <t t-out="foodStage.served"/>
                </span>
            </div>
        </xpath>
    </t>
</templates>
