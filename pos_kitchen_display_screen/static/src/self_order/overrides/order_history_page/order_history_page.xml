<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_kitchen_display_screen.OrdersHistoryPage" t-inherit="pos_self_order.OrdersHistoryPage" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('badge')]" position="before">
            <span t-if="this.getOrderStageName(order)"
                  class="badge py-2 px-3 rounded-pill text-white fw-bold d-flex align-items-center gap-1"
                  t-att-style="'background-color: ' + this.getOrderStageColor(order) + ' !important; font-size: 0.85rem;'">
                <i t-if="order.prep_status === 'ready'" class="oi oi-filled" data-icon="bell"/>
                <i t-elif="order.prep_status === 'served'" class="oi oi-filled" data-icon="check"/>
                <t t-out="this.getOrderStageName(order)"/>
            </span>
        </xpath>

        <xpath expr="//div[hasclass('o_self_product_name')]" position="after">
            <div t-if="this.getLineStageName(line)" class="d-flex align-items-center gap-2 mt-1">
                <span class="badge py-1 px-2 rounded-pill text-white"
                      t-att-style="'background-color: ' + this.getLineStageColor(line) + ' !important; font-size: 0.75rem;'">
                    <t t-out="this.getLineStageName(line)"/>
                </span>
                <span t-if="line.prep_stage_change_time || line.prep_sent_time" class="text-muted smaller">
                    <t t-out="this.formatTime(line.prep_stage_change_time || line.prep_sent_time)"/>
                </span>
            </div>
        </xpath>
    </t>
</templates>
