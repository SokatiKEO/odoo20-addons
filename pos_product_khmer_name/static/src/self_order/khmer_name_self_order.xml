<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="pos_self_order.ProductInterface" t-inherit-mode="extension">
        <xpath expr="//h2[hasclass('o_self_product_name')]" position="attributes">
            <attribute name="t-out">product.displayKhmerOrName</attribute>
        </xpath>
        <xpath expr="//h1[@t-ref='this.productNameRef']" position="attributes">
            <attribute name="t-out">product.displayKhmerOrName</attribute>
        </xpath>
    </t>

    <t t-inherit="pos_self_order.CartPage" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-cart-item')]//t[@t-out='product.name']" position="attributes">
            <attribute name="t-out">product.displayKhmerOrName</attribute>
        </xpath>
    </t>

    <t t-inherit="pos_self_order.ProductInfoPopup" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('modal-body')]/h2[@t-out='product.name']" position="attributes">
            <attribute name="t-out">product.displayKhmerOrName</attribute>
        </xpath>
    </t>
</templates>

