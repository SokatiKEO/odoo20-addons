<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="pos_self_order.ProductInterface" t-inherit-mode="extension">
        <xpath expr="//h2[@t-out='product.name']" position="attributes">
            <attribute name="t-out">product.displayKhmerOrName</attribute>
        </xpath>
        <xpath expr="//h1[@t-out='product.name']" position="attributes">
            <attribute name="t-out">product.displayKhmerOrName</attribute>
        </xpath>
    </t>

    <t t-inherit="pos_self_order.CartPage" t-inherit-mode="extension">
        <xpath expr="//t[@t-out='product.name']" position="attributes">
            <attribute name="t-out">product.displayKhmerOrName</attribute>
        </xpath>
    </t>

    <t t-inherit="pos_self_order.ProductInfoPopup" t-inherit-mode="extension">
        <xpath expr="//h2[@t-out='product.name']" position="attributes">
            <attribute name="t-out">product.displayKhmerOrName</attribute>
        </xpath>
    </t>
</templates>
