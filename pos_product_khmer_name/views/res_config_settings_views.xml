<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_khmer_name" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.khmer.name</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting id="pos_show_khmer_name_setting"
                         string="Show Product Khmer Name"
                         help="Display the product's Khmer Name (if set) instead of its default name in POS, Kitchen Display, and Customer Self-Order.">
                    <field name="pos_show_khmer_name"/>
                </setting>
            </xpath>
        </field>
    </record>

    <record id="pos_config_view_form_inherit_khmer_name" model="ir.ui.view">
        <field name="name">pos.config.form.view.inherit.khmer.name</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='configuration']//div[hasclass('o_settings_container')]" position="inside">
                <setting id="show_khmer_name_config_setting"
                         string="Show Product Khmer Name"
                         help="Display the product's Khmer Name (if set) instead of its default name in POS, Kitchen Display, and Customer Self-Order.">
                    <field name="show_khmer_name"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>

