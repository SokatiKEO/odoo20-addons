<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_table_name.edit_table_properties" t-inherit="pos_restaurant.floor_editor.edit_table_properties" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'fw-bold')][1]" position="before">
            <div class="fs-4 fw-bold mb-2 mt-3">Table Name</div>
            <input type="text" class="form-control form-control-lg" placeholder="e.g. VIP 1, Patio A" t-att-value="this.table.table_name" t-on-input="this.updateTableName"/>
        </xpath>
    </t>
</templates>
